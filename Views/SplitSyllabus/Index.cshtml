@{
    ViewBag.Title = "Overview";
    Layout = "~/Views/Shared/_SplitSyllabusLayout.cshtml";
}
<div class="dashboard-page" id="overview" data-soe-coverage-url="@Url.Action("SoeCoverage", "SplitSyllabus")">
    <div class="page-heading"><div><div class="page-eyebrow">SYLLABUS MONITORING</div><h1>Every topic. Every school.</h1><p>A clearer picture of syllabus progress across Jharkhand.</p></div><div class="heading-actions"><button class="btn export-button" id="export-report" type="button"><svg class="icon"><use href="#i-download" /></svg>Export sample CSV</button></div></div>
    <form class="filter-panel" id="dashboard-filters">
        <div class="filter-fields">
            <div class="filter-field"><label for="academic-year">Academic year</label><select class="form-select" id="academic-year" name="academicYear"><option value="2026">2026-27</option></select></div>
            <div class="filter-field"><label for="syllabus-month">Syllabus month</label><select class="form-select" id="syllabus-month" name="month"><option value="4">April 2026</option><option value="5">May 2026</option><option value="6">June 2026</option><option value="7">July 2026</option><option value="8">August 2026</option><option value="9">September 2026</option><option value="10" selected>October 2026</option><option value="11">November 2026</option><option value="12">December 2026</option><option value="1">January 2027</option><option value="2">February 2027</option><option value="3">March 2027</option></select></div>
            <div class="filter-field"><label for="class-filter">Class</label><select class="form-select" id="class-filter" name="class"><option value="all">All classes</option>@for (var grade = 1; grade <= 12; grade++) { <option value="@grade">Class @grade</option> }</select></div>
            <div class="filter-field"><label for="subject-filter">Subject</label><select class="form-select" id="subject-filter" name="subject"><option value="all">All subjects</option><option value="mathematics">Mathematics</option><option value="science">Science</option><option value="english">English</option><option value="hindi">Hindi</option><option value="social-science">Social science</option></select></div>
            <div class="filter-field"><label for="cohort-filter">School cohort</label><select class="form-select" id="cohort-filter" name="cohort"><option value="all">All schools</option><option value="soe">SOE schools</option><option value="other">Other than SOE</option></select></div>
            <div class="filter-field"><label for="district-filter">District</label><select class="form-select" id="district-filter" name="district"><option value="all">All districts</option></select></div>
        </div>
        <div class="filter-footer"><span id="scope-label">October 2026 &middot; All classes &middot; All subjects &middot; All schools</span><div><button class="reset-button" type="reset">Reset filters</button><button class="btn apply-button" type="submit">Apply filters <svg class="icon"><use href="#i-arrow" /></svg></button></div></div>
    </form>
    <div class="section-title"><h2>At a glance</h2><span id="period-label">October 2026</span></div>
    <div class="cohort-grid">
        <section class="cohort-card soe-card" id="soe-card" aria-labelledby="soe-title"><div class="cohort-top"><span class="cohort-icon"><svg class="icon"><use href="#i-school" /></svg></span><div><h3 id="soe-title">Schools of Excellence</h3><p>SOE syllabus coverage</p></div><span class="cohort-tag">SOE</span></div><div class="cohort-values"><div><span>Target</span><strong id="soe-target">N/A</strong><small id="soe-goal-label">Configured goal</small></div><div><span>Achieved</span><strong id="soe-achieved">N/A</strong><small>Approved completion</small></div><div class="cohort-gap"><span id="soe-gap">N/A</span><small>to target</small></div></div><div class="cohort-progress"><div id="soe-progress"></div><i id="soe-target-marker" hidden></i></div><div class="cohort-foot"><span id="soe-basis-label">SQL Server</span></div><p id="soe-data-status" class="soe-data-status" role="status" aria-live="polite">Loading SOE coverage from the server.</p></section>
        <section class="cohort-card other-card" aria-labelledby="other-title"><div class="cohort-top"><span class="cohort-icon"><svg class="icon"><use href="#i-school" /></svg></span><div><h3 id="other-title">Other schools</h3><p>Other-than-SOE syllabus coverage</p></div><span class="cohort-tag">NON-SOE</span></div><div class="cohort-values"><div><span>Target</span><strong id="other-target">&mdash;</strong><small>Monthly goal</small></div><div><span>Achieved</span><strong id="other-achieved">&mdash;</strong><small>Approved completion</small></div><div class="cohort-gap"><span id="other-gap">&mdash;</span><small>to target</small></div></div><div class="cohort-progress"><div id="other-progress"></div><i id="other-target-marker"></i></div><div class="cohort-foot"><span id="other-topics">Loading sample topics</span><span>Selected-month basis</span></div></section>
    </div>
    <div class="metric-grid" id="participation">
        <section class="metric-card"><span class="metric-icon teal"><svg class="icon"><use href="#i-users" /></svg></span><span class="metric-label">Teachers started</span><strong id="teachers-started">&mdash;</strong><span class="metric-detail" id="teachers-started-detail">At least one topic request</span></section>
        <section class="metric-card"><span class="metric-icon violet"><svg class="icon"><use href="#i-school" /></svg></span><span class="metric-label">Schools started</span><strong id="schools-started">&mdash;</strong><span class="metric-detail" id="schools-started-detail">Distinct school codes</span></section>
        <section class="metric-card"><span class="metric-icon amber"><svg class="icon"><use href="#i-clock" /></svg></span><span class="metric-label">Teachers not started</span><strong id="teachers-not-started">&mdash;</strong><span class="metric-detail">No topic requests in scope</span></section>
        <section class="metric-card"><span class="metric-icon blue"><svg class="icon"><use href="#i-pin" /></svg></span><span class="metric-label">Districts started</span><strong id="districts-started">&mdash;</strong><span class="metric-detail" id="districts-started-detail">District participation</span></section>
        <section class="metric-card"><span class="metric-icon pink"><svg class="icon"><use href="#i-grid" /></svg></span><span class="metric-label">Blocks started</span><strong id="blocks-started">&mdash;</strong><span class="metric-detail" id="blocks-started-detail">Block participation</span></section>
    </div>
    <div class="insight-strip"><span class="insight-icon"><svg class="icon"><use href="#i-chart" /></svg></span><p id="insight-text">Preparing the sample district overview.</p><a href="#district-report">Explore report <svg class="icon"><use href="#i-arrow" /></svg></a></div>
    <div class="analysis-grid" id="geography">
        <div class="geography-column">
            <section class="dashboard-panel district-panel"><div class="panel-heading"><div><div class="panel-eyebrow">GEOGRAPHIC PERFORMANCE</div><h2>Districts, side by side</h2><p>Target and achieved syllabus coverage in the selected month.</p></div><span class="panel-count" id="district-chart-count">24 districts</span></div><div class="chart-toolbar"><div class="chart-legend"><span><i class="target-key"></i>Target</span><span><i class="achieved-key"></i>Achieved</span></div><label class="chart-sort-label">Sort by <select id="chart-sort"><option value="name">District name</option><option value="achieved">Achievement</option><option value="gap">Largest gap</option></select></label></div><div class="chart-axis" aria-hidden="true"><span></span><div><span>0%</span><span>25%</span><span>50%</span><span>75%</span><span>100%</span></div><span></span></div><div id="district-chart" class="geography-chart" aria-label="District target and achieved comparison"></div><div class="chart-hint"><svg class="icon"><use href="#i-pin" /></svg>Select a district name to explore its blocks below.</div></section>
            <section class="dashboard-panel block-panel" id="block-panel" hidden aria-labelledby="block-title"><div class="panel-heading"><div><div class="panel-eyebrow">DISTRICT DRILLDOWN</div><h2 id="block-title">Block performance</h2><p id="block-description" aria-live="polite"></p></div><button type="button" class="icon-button" id="close-blocks" aria-label="Close block comparison"><svg class="icon"><use href="#i-close" /></svg></button></div><div class="chart-legend"><span><i class="target-key"></i>Target</span><span><i class="achieved-key"></i>Achieved</span></div><div class="chart-axis" aria-hidden="true"><span></span><div><span>0%</span><span>25%</span><span>50%</span><span>75%</span><span>100%</span></div><span></span></div><div id="block-chart" class="geography-chart block-chart"></div><p class="block-footnote">Illustrative block names and figures. Live geography will use your district and block masters.</p></section>
        </div>
        <div class="snapshot-column">
            <section class="dashboard-panel approval-panel" id="approval-summary"><div class="panel-heading"><div><div class="panel-eyebrow">REQUEST LIFECYCLE</div><h2>Approval snapshot</h2><p>Sample requests in the selected scope.</p></div></div><div class="approval-ring" id="approval-ring"><div><strong id="approval-rate">&mdash;</strong><span>approved</span></div></div><div class="approval-list"><div><span><i class="status-bullet approved"></i>Approved</span><strong id="approved-requests">&mdash;</strong></div><div><span><i class="status-bullet pending"></i>Awaiting approval</span><strong id="pending-requests">&mdash;</strong></div><div><span><i class="status-bullet rejected"></i>Needs revision</span><strong id="rejected-requests">&mdash;</strong></div></div><div class="panel-note">A request starts participation. Only principal-approved completion counts toward achievement.</div></section>
            <section class="dashboard-panel participation-panel"><div class="panel-eyebrow">TEACHER ENGAGEMENT</div><h2>Participation matters.</h2><strong class="engagement-number" id="participation-rate">&mdash;</strong><p>of eligible sample teachers have started requesting topics.</p><div class="engagement-track"><div id="participation-progress"></div></div><div class="engagement-labels"><span id="engagement-started">Started</span><span id="engagement-remaining">Not started</span></div><div class="engagement-foot">Teacher role: <strong>102</strong><span>Requests count before approval</span></div></section>
        </div>
    </div>
    <section class="dashboard-panel trend-panel"><div class="panel-heading"><div><div class="panel-eyebrow">MONTHLY MOMENTUM</div><h2>The academic year, in perspective</h2><p>Sample target and achievement by syllabus month through the selected period.</p></div><div class="chart-legend"><span><i class="target-key"></i>Target</span><span><i class="achieved-key"></i>Achieved</span></div></div><div id="monthly-chart" class="monthly-chart"></div><div class="trend-foot"><span>Monthly completion, not cumulative annual progress</span><span id="approved-topics-total">Approved topics in selected month</span></div></section>
    <section class="dashboard-panel report-panel" id="district-report"><div class="panel-heading"><div><div class="panel-eyebrow">THE DETAIL BEHIND THE NUMBERS</div><h2>District performance report</h2><p>Participation, approved topics, and the distance to target.</p></div><div class="report-search"><label class="visually-hidden" for="district-search">Search district report</label><input id="district-search" class="form-control" type="search" placeholder="Search a district" /></div></div><div class="table-responsive"><table class="table district-table"><caption class="visually-hidden">Sample district performance for the applied filters. Target and achieved percentages use monthly topics.</caption><thead><tr><th scope="col">District</th><th scope="col">Schools started</th><th scope="col">Teachers started</th><th scope="col">Approved topics</th><th scope="col">Target</th><th scope="col">Achieved</th><th scope="col">Gap</th><th scope="col">Progress</th></tr></thead><tbody id="district-table-body"></tbody></table></div><div class="report-footer"><span id="report-count" aria-live="polite">24 sample districts</span><span>Click a district to view block performance</span></div></section>
    <div class="data-basis-note"><svg class="icon"><use href="#i-book" /></svg><p><strong>Know the basis.</strong> The SOE card displays average monthly coverage from SplitSyllabusCompletedDetails and the average configured target from Tbl_SplitSyllabusTargetPercentage. Other cards and charts still use illustrative monthly data. A month can contain multiple topics.</p></div>
    <div class="dashboard-status visually-hidden" id="dashboard-status" role="status" aria-live="polite"></div>
    <noscript><div class="alert alert-warning">Enable JavaScript to display the illustrative metrics and charts. This page has no live database connection.</div></noscript>
</div>
@section scripts {
    <script src="@Url.Content("~/Scripts/split-syllabus.js")"></script>
}
