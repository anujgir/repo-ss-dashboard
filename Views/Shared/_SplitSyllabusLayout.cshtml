<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Split Syllabus dashboard design preview for Jharkhand syllabus coverage and participation." />
    <title>@ViewBag.Title | Split Syllabus</title>
    <link href="@Url.Content("~/Content/bootstrap.min.css")" rel="stylesheet" />
    <link href="@Url.Content("~/Content/split-syllabus.css")" rel="stylesheet" />
</head>
<body class="syllabus-app">
    <svg xmlns="http://www.w3.org/2000/svg" class="icon-library" aria-hidden="true">
        <symbol id="i-grid" viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></symbol>
        <symbol id="i-book" viewBox="0 0 24 24"><path d="M12 5c-3-2-6-2-9-1v15c3-1 6-1 9 1 3-2 6-2 9-1V4c-3-1-6-1-9 1Zm0 0v15"/></symbol>
        <symbol id="i-users" viewBox="0 0 24 24"><circle cx="9" cy="8" r="3"/><path d="M3 21v-3a6 6 0 0 1 12 0v3M16 5a3 3 0 0 1 0 6m2 3a5 5 0 0 1 3 5v2"/></symbol>
        <symbol id="i-school" viewBox="0 0 24 24"><path d="m3 9 9-6 9 6v12H3Zm6 12v-7h6v7M7 10h2m6 0h2"/></symbol>
        <symbol id="i-pin" viewBox="0 0 24 24"><path d="M20 10c0 6-8 11-8 11S4 16 4 10a8 8 0 1 1 16 0Z"/><circle cx="12" cy="10" r="2.5"/></symbol>
        <symbol id="i-chart" viewBox="0 0 24 24"><path d="M3 3v18h18M7 16l4-5 4 2 5-7"/></symbol>
        <symbol id="i-check" viewBox="0 0 24 24"><path d="m5 12 4 4L19 6"/></symbol>
        <symbol id="i-arrow" viewBox="0 0 24 24"><path d="M5 12h14m-6-6 6 6-6 6"/></symbol>
        <symbol id="i-download" viewBox="0 0 24 24"><path d="M12 3v12m-4-4 4 4 4-4M4 16v5h16v-5"/></symbol>
        <symbol id="i-menu" viewBox="0 0 24 24"><path d="M4 6h16M4 12h16M4 18h16"/></symbol>
        <symbol id="i-close" viewBox="0 0 24 24"><path d="m6 6 12 12M18 6 6 18"/></symbol>
        <symbol id="i-clock" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></symbol>
    </svg>
    <a class="skip-link" href="#dashboard-content">Skip to dashboard</a>
    <div class="sidebar-shade" id="sidebar-shade" hidden></div>
    <aside class="dashboard-sidebar" id="dashboard-sidebar" aria-label="Dashboard navigation">
        <a class="sidebar-brand" href="@Url.Action("Index", "SplitSyllabus")"><span class="brand-mark"><svg class="icon"><use href="#i-book" /></svg></span><span>Split Syllabus<small>JHARKHAND EDUCATION</small></span></a>
        <button class="sidebar-close icon-button" type="button" id="sidebar-close" aria-label="Close navigation"><svg class="icon"><use href="#i-close" /></svg></button>
        <div class="sidebar-label">WORKSPACE</div>
        <nav class="sidebar-nav">
            <a href="#overview" class="active" aria-current="page"><svg class="icon"><use href="#i-grid" /></svg>Overview<span class="nav-dot"></span></a>
            <a href="#geography"><svg class="icon"><use href="#i-pin" /></svg>District performance</a>
            <a href="#participation"><svg class="icon"><use href="#i-users" /></svg>Teacher participation</a>
            <a href="#approval-summary"><svg class="icon"><use href="#i-check" /></svg>Approval summary</a>
            <a href="#district-report"><svg class="icon"><use href="#i-chart" /></svg>District report</a>
        </nav>
        <div class="sidebar-year"><span>ACADEMIC YEAR</span><strong>2026 <span class="year-line"></span> 2027</strong><small>April to March</small><div class="year-months"><i></i><i></i><i></i><i></i><i></i><i></i><i class="current"></i><i class="future"></i><i class="future"></i><i class="future"></i><i class="future"></i><i class="future"></i></div></div>
        <div class="sidebar-note"><svg class="icon"><use href="#i-book" /></svg><strong>Progress begins with a topic.</strong><p>A shared view of teaching, approvals, and syllabus coverage.</p><a href="@Url.Content("~/docs/split-syllabus-prd.html")" target="_blank" rel="noopener">Read the requirements <svg class="icon"><use href="#i-arrow" /></svg></a></div>
        <div class="sidebar-footer"><span class="avatar">SS</span><div><strong>State dashboard</strong><small>Design preview</small></div><span class="status-dot"></span></div>
    </aside>
    <div class="dashboard-workspace">
        <header class="workspace-topbar"><div class="topbar-left"><button class="icon-button menu-toggle" id="sidebar-open" type="button" aria-controls="dashboard-sidebar" aria-expanded="false" aria-label="Open navigation"><svg class="icon"><use href="#i-menu" /></svg></button><span class="breadcrumb-label">Education monitoring</span><span class="breadcrumb-divider">/</span><strong>Split syllabus</strong></div><div class="topbar-right"><span class="demo-pill"><span></span>Sample data</span><span class="topbar-year">AY 2026-27</span><span class="avatar light">SS</span></div></header>
        <main id="dashboard-content" tabindex="-1">@RenderBody()</main>
        <footer class="workspace-footer"><span>Split Syllabus <span class="footer-dot">&bull;</span> Jharkhand education dashboard</span><span>Design preview <span class="footer-dot">&bull;</span> No live database connection</span></footer>
    </div>
    <script src="@Url.Content("~/Scripts/bootstrap.bundle.min.js")"></script>
    @RenderSection("scripts", required: false)
</body>
</html>
